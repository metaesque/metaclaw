        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "query_result(host_metadata_active)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "host",
        "options": [],
        "query": {
          "query": "query_result(host_metadata_active)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "/host=\"([^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
