# ==============================================================================
# STABLE AUDIO OPEN LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Sets the Stable Audio Cog Docker image version.
# WHY THIS DEFAULT: The stackadoc image provides a reliable wrapper for the
# model weights, exposing a standard HTTP prediction API.
STABLEAUDIO_VERSION=latest

# WHAT THIS DOES: The port Stable Audio listens on for incoming REST API requests.
# WHY THIS DEFAULT: 5000 is the native default for Cog API servers.
STABLEAUDIO_PORT=5000

# WHAT THIS DOES: Parameterizes the compose files to load based on hardware.
# WHY IT MATTERS: Injected by orchestrate.py so NVIDIA loads deploy blocks and AMD loads device blocks.
STABLEAUDIO_COMPOSE_FILE=change_me_to_STABLEAUDIO_COMPOSE_FILE[docker-compose.yml:docker-compose.nvidia.yml]
