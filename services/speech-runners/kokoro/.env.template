# ==============================================================================
# KOKORO TTS LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Sets the Kokoro FastAPI Docker image version.
# WHY THIS DEFAULT: The CPU variant is exceptionally fast (0.3s for 10s audio) and
# ensures compatibility across all deployment tiers without requiring GPU drivers.
KOKORO_VERSION=latest

# WHAT THIS DOES: The port Kokoro listens on for incoming REST API requests.
# WHY THIS DEFAULT: 8880 is the native default for the Kokoro-FastAPI container.
KOKORO_PORT=8880
