# ==============================================================================
# COMFYUI LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Sets the ComfyUI Docker image.
# WHY THIS DEFAULT: Injected dynamically by orchestrate.py based on hardware capabilities.
COMFYUI_IMAGE_URI=change_me_to_COMFYUI_IMAGE_URI[ghcr.io/ai-dock/comfyui:latest-cuda]

# WHAT THIS DOES: Defines the internal working directory mapped to host volumes.
# WHY THIS DEFAULT: Injected dynamically because ai-dock and yanwk store data in different paths.
COMFYUI_WORKDIR=change_me_to_COMFYUI_WORKDIR[/opt/ComfyUI]

# WHAT THIS DOES: The port ComfyUI listens on for incoming REST API and WebSocket requests.
# WHY THIS DEFAULT: 8188 is the native default for ComfyUI.
COMFYUI_PORT=8188

# WHAT THIS DOES: Parameterizes the compose files to load based on hardware.
# WHY IT MATTERS: Injected by orchestrate.py so NVIDIA loads deploy blocks and AMD loads device blocks.
COMFYUI_COMPOSE_FILE=change_me_to_COMFYUI_COMPOSE_FILE[docker-compose.yml:docker-compose.nvidia.yml]
