# ==============================================================================
# COMFYUI LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Sets the ComfyUI Docker image version.
# WHY THIS DEFAULT: AI-Dock provides a highly configurable, CUDA-optimized
# environment tailored for API-driven diffusion workflows.
COMFYUI_VERSION=latest-cuda

# WHAT THIS DOES: The port ComfyUI listens on for incoming REST API and WebSocket requests.
# WHY THIS DEFAULT: 8188 is the native default for ComfyUI.
COMFYUI_PORT=8188
