# ==============================================================================
# VICTORIAMETRICS LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Pins the single-node VictoriaMetrics TSDB to a stable release.
# WHY THIS DEFAULT: Ensures our PromQL/MetricsQL queries and storage schemas
# remain stable across cluster updates.
VICTORIAMETRICS_VERSION=v1.101.0
VICTORIAMETRICS_PORT=8428

# WHAT THIS DOES: Defines the retention policy for time-series metrics.
# WHY THIS DEFAULT: Retains 1 month of high-frequency hardware metrics to
# analyze cluster degradation over time without exhausting SSD storage.
VICTORIAMETRICS_RETENTION=1M
