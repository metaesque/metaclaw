# ==============================================================================
# VICTORIAMETRICS TSDB LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Pins the single-node VictoriaMetrics TSDB to a stable release.
# WHY THIS DEFAULT: Ensures our PromQL/MetricsQL queries and storage schemas
# remain stable across cluster updates.
VICTORIAMETRICS_TSDB_VERSION=v1.101.0
VICTORIAMETRICS_TSDB_PORT=8428

# WHAT THIS DOES: Defines the retention policy for time-series metrics.
# WHY THIS DEFAULT: Retention has been explicitly set to 100 years to maintain
# historical telemetry forever. VictoriaMetrics is highly compressed (less than 1 byte
# per data point), making infinite retention of hardware telemetry viable on edge SSDs.
# NOTE: VictoriaMetrics forbids "M" or "m" for months due to ambiguity with minutes.
VICTORIAMETRICS_TSDB_RETENTION=100y
