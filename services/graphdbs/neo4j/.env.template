# ==============================================================================
# NEO4J LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Pins the Neo4j database to a stable community release version.
NEO4J_VERSION=5.20.0-community
NEO4J_PORT_HTTP=7474
NEO4J_PORT_BOLT=7687

# WHAT THIS DOES: Sets the password for the default 'neo4j' user.
# WHY THIS DEFAULT: Required by the Neo4j container to start securely.
NEO4J_PASSWORD=change_me_to_AUTO_PASSWORD
