# ==============================================================================
# NODE EXPORTER LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# WHAT THIS DOES: Pins the Node Exporter sidecar to a known working version.
# WHY THIS DEFAULT: Version 1.8.1 provides stable hardware telemetry extraction
# compatible with Prometheus-based TSDBs without severe overhead.
NODE_EXPORTER_VERSION=v1.8.1

# WHAT THIS DOES: Exposes the metric scraping port to the internal network.
NODE_EXPORTER_PORT=9100
